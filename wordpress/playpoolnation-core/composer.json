{
  "name": "playpoolnation/playpoolnation-core",
  "description": "PlayPoolNation core WordPress plugin",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": { "php": ">=8.1" },
  "require-dev": { "phpunit/phpunit": "^10.5" },
  "scripts": {
    "test": "phpunit -c tests/phpunit.xml",
