---
/** A city guide as a poster: the city's illustration, its name, and how many places. Falls back to a felt card. */
import { posterFor } from '../lib/posters.ts';

const { url, name, count, sub = '', eager = false } = Astro.props as { url: string; name: string; count: number; sub?: string; eager?: boolean };
const poster = posterFor(url);
---
<a class:list={['poster', { 'poster--plain': !poster }]} href={url}>
  {poster && (
    <img
      src={poster.srcSm}
      srcset={`${poster.srcSm} 480w, ${poster.src} 900w`}
      sizes="(min-width: 1100px) 260px, (min-width: 720px) 30vw, 70vw"
      width="480" height="600" alt="" loading={eager ? 'eager' : 'lazy'} decoding="async"
    />
  )}
  <span class="poster-text">
    <span class="poster-name">{name}</span>
    <span class="poster-meta">{count === 1 ? '1 place' : `${count} places`}{sub && ` · ${sub}`}</span>
  </span>
</a>
