---
import { caption, groups, summary, MAX_DRAWN } from '../lib/room.ts';
import type { Venue } from '../lib/types.ts';
import { tables } from '../lib/text.ts';
const { v } = Astro.props as { v: Venue };
const list = groups(v.sizeCounts, tables(v), v.models);
let drawn = 0;
const rows = list.map((g) => {
  const n = Math.max(0, Math.min(g.count, MAX_DRAWN - drawn));
  drawn += n;
  return { g, n, mod: g.size || 'unknown' };
});
const total = list.reduce((s, g) => s + g.count, 0);
---
{list.length > 0 && (
  <figure class="room" role="img" aria-label={summary(list)}>
    <svg width="0" height="0" class="room-defs" aria-hidden="true" focusable="false">
      <symbol id="room-table" viewBox="0 0 120 64">
        <rect class="room-rail" x="1" y="1" width="118" height="62" rx="7" />
        <rect class="room-felt" x="8" y="8" width="104" height="48" rx="2" />
        <g class="room-pocket"><circle cx="9" cy="9" r="4" /><circle cx="60" cy="7" r="3.6" /><circle cx="111" cy="9" r="4" /><circle cx="9" cy="55" r="4" /><circle cx="60" cy="57" r="3.6" /><circle cx="111" cy="55" r="4" /></g>
        <circle class="room-spot" cx="34" cy="32" r="1.6" />
      </symbol>
    </svg>
    {rows.map(({ g, n, mod }) => (
      <div class="room-group" aria-hidden="true">
        <p class="room-cap">{caption(g, list.length === 1)}</p>
        <div class="room-row">{Array.from({ length: n }, () => <svg class={`room-t room-t--${mod}`} viewBox="0 0 120 64"><use href="#room-table" /></svg>)}</div>
      </div>
    ))}
    {total > drawn && <p class="room-cap" aria-hidden="true">+{total - drawn} more not drawn</p>}
    <figcaption class="room-note">Drawn to scale by table size. Not a floor plan.</figcaption>
  </figure>
)}
