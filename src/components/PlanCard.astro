---
/**
 * "Plan your game": party size, a day and a time slot, like a restaurant booking widget,
 * but honest about it. We don't book tables: slots come from the posted hours (the last
 * one an hour before close), and picking one gives Call to hold a table, a calendar
 * invite and a link to send friends, which reopens this card with the same plan.
 * Filled in by src/scripts/site.ts; hidden without JavaScript (Call and hours are on the page).
 */
import { e164 } from '../lib/format.ts';
import type { Venue } from '../lib/types.ts';

const { v } = Astro.props as { v: Venue };
const tel = e164(v.phone);
const dest = [v.address.street, v.address.city, v.address.state, v.address.postal_code].filter(Boolean).join(', ');
const show = v.status === 'open' && (v.hours?.ranges?.length ?? 0) > 0;
---
{show && (
  <section
    class="plan"
    aria-labelledby="plan-title"
    data-plan
    hidden
    data-tl-hours={JSON.stringify({ tz: v.hours!.tz, r: v.hours!.ranges, s: v.status })}
    data-name={v.name}
    data-venue={v.slug}
    data-tel={tel}
    data-dest={dest}
  >
    <h2 id="plan-title">Plan your game</h2>
    <div class="plan-row">
      <label for="plan-players">Players</label>
      <select id="plan-players" data-plan-players>
        {[1, 2, 3, 4, 5, 6, 7, 8, 10, 12].map((n) => <option value={n} selected={n === 2}>{n === 1 ? '1 player' : `${n} players`}</option>)}
      </select>
    </div>
    <p class="plan-tables" data-plan-tables></p>
    <div class="plan-days" role="group" aria-label="Day" data-plan-days></div>
    <div class="plan-slots" role="group" aria-label="Time" data-plan-slots></div>
    <div class="plan-pick" data-plan-pick hidden>
      <p class="plan-summary" aria-live="polite" data-plan-summary></p>
      <div class="plan-actions">
        {tel && <a class="btn" href={`tel:${tel}`} data-ppn-event="call" data-venue={v.slug} data-where="plan_card">Call to hold a table</a>}
        <button type="button" class="btn btn--ghost" data-plan-invite>Invite friends</button>
        <button type="button" class="btn btn--ghost" data-plan-ics>Add to calendar</button>
      </div>
      <p class="plan-copied" aria-live="polite" data-plan-copied></p>
    </div>
    <p class="plan-note">PlayPoolNation doesn't book tables. Times come from {v.name}'s posted hours, so call ahead to hold one.</p>
  </section>
)}
