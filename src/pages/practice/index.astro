---
/** The 3D pool game (tailuge/billiards, GPL-3.0). Its 2 MB of scripts load only when Play is pressed. */
import Base from '../../layouts/Base.astro';
import { BRAND } from '../../lib/data.ts';
---
<Base title={`Practice Pool Online: Free 3D Pool Game | ${BRAND}`} description="Play a few racks of 8-ball, 9-ball or 10-ball in your browser. A free, open-source 3D pool game with real physics. No download, no account." crumbs={[['Home', '/'], ['Practice', '']]} pageType="practice">
  <p class="eyebrow">Practice</p>
  <h1>Play a few racks</h1>
  <p class="lede">A free, open-source pool game with realistic 3D physics that runs right in your browser. No download, no account.</p>
  <form class="chips" style="margin:16px 0" data-game-controls>
    <label class="chip">Game
      <select name="ruletype"><option value="eightball">8-ball</option><option value="nineball" selected>9-ball</option><option value="tenball">10-ball</option><option value="freeplay">Practice</option></select>
    </label>
    <label class="chip">Table
      <select name="tableSize"><option value="7.83">7-foot</option><option value="8.86">8-foot</option><option value="10" selected>9-foot</option></select>
    </label>
  </form>
  <div class="game-frame" data-game>
    <button type="button" class="btn" data-game-play>Play</button>
  </div>
  <p class="muted" style="font-size:14px;margin-top:10px">Game by tailuge, adapted for this site. Free and open source under the <a href="/practice-game/LICENSE.txt">GPL-3.0 license</a>. <a href="/practice-game/source.zip">Download the source code</a>. <a href="/practice-game/index.html?ruletype=nineball&tableSize=10" data-game-full>Open the game full-screen</a>.</p>
</Base>
<script>
  const box = document.querySelector<HTMLElement>('[data-game]');
  const form = document.querySelector<HTMLFormElement>('[data-game-controls]');
  const full = document.querySelector<HTMLAnchorElement>('[data-game-full]');
  const src = () => '/practice-game/index.html?' + new URLSearchParams(new FormData(form!) as any).toString();
  form?.addEventListener('change', () => {
    if (full) full.href = src();
    const frame = box?.querySelector('iframe');
    if (frame) frame.src = src();
  });
  box?.querySelector('[data-game-play]')?.addEventListener('click', (e) => {
    (e.currentTarget as HTMLElement).remove();
    const frame = document.createElement('iframe');
    frame.title = 'Billiards game';
    frame.allow = 'fullscreen';
    frame.src = src();
    box.append(frame);
  });
</script>
