---
import Base from '../layouts/Base.astro';
import PosterCard from '../components/PosterCard.astro';
import Feed from '../components/Feed.astro';
import NationMap from '../components/NationMap.astro';
import { cityPages, metroLink, metros, states, venues } from '../lib/data.ts';

const all = venues();
const cityList = cityPages();
const metroList = metros().filter((m) => m.venues.length > 0);
const stateCount = states().length;
---
<Base
  title="PlayPoolNation: Pool Halls & Bars With Pool Tables Near You"
  description={`${all.length} pool halls and bars with pool tables, with table counts, sizes, league nights and who's open right now. Every fact has a source.`}
  pageType="home"
>
  <section class="hero" slot="hero">
    <picture>
      <source media="(max-width: 720px)" srcset="/img/ppn-hero-rack-mobile.jpg" />
      <img src="/img/ppn-hero-rack.jpg" alt="" width="2048" height="1024" fetchpriority="high" />
    </picture>
    <div class="wrap">
      <div>
        <h1>Every pool table <em>worth the drive.</em></h1>
        <p>{all.length} pool halls and bars with pool tables in {stateCount} states. See who's open right now, how many tables they have, and when the leagues play.</p>
      </div>
      <form class="ask" id="tonight" data-ask action="/search/" onsubmit="return false">
        <p class="ask-eyebrow">Ask it like you'd ask a friend</p>
        <p class="ask-line">
          Find me
          <label class="visually-hidden" for="ask-table">Table</label>
          <select id="ask-table" name="table" data-slot>
            <option value="">any table</option>
            <option value="nine">a 9-foot table</option>
            <option value="many">a room with 6+ tables</option>
          </select>
          at
          <label class="visually-hidden" for="ask-kind">Kind of place</label>
          <select id="ask-kind" name="kind" data-slot>
            <option value="">any spot</option>
            <option value="hall">a real pool hall</option>
            <option value="bar">a bar</option>
          </select>
          <label class="visually-hidden" for="ask-where">Where</label>
          <select id="ask-where" name="where" data-slot>
            <option value="">anywhere</option>
            <option value="near" data-near hidden>near me</option>
            {cityList.map((c) => <option value={c.key}>in {c.where}</option>)}
          </select>
          that's
          <label class="visually-hidden" for="ask-when">When</label>
          <select id="ask-when" name="when" data-slot>
            <option value="open">open right now</option>
            <option value="late">open past midnight tonight</option>
            <option value="league">running a league tonight</option>
            <option value="free">got free pool</option>
            <option value="food">serving food</option>
            <option value="">open whenever</option>
          </select>.
        </p>
        <div class="answer" aria-live="polite" data-ask-answer>
          <p class="answer-count" data-ask-count>Pick anything above and the answer shows up here.</p>
          <ol class="picks" data-ask-picks></ol>
          <p class="answer-more">
            <button type="button" class="btn btn--ghost" data-ask-more hidden></button>
            <a class="btn btn--ghost" href="/places/" data-ask-fallback>Browse every city</a>
          </p>
        </div>
      </form>
    </div>
  </section>

  <div class="section"><Feed title="Live from the halls" limit={6} more="/live/" /></div>

  <NationMap />

  <section class="band" aria-labelledby="pick-city">
    <div class="wrap">
      <h2 id="pick-city">Pick a city</h2>
      <p>Each guide lists every place we know, with tables, league nights and who's open now.</p>
      <ul class="poster-rail">
        {metroList.map((m) => <li><PosterCard url={metroLink(m)} name={m.label} count={m.venues.length} /></li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="panel split">
      <div>
        <h2>Your hall belongs on the map</h2>
        <p>Listing your venue is free. Already listed? Claim it to add your tables, rates and league nights, and see how many people call and get directions from PlayPoolNation.</p>
        <p class="actions"><a class="btn" href="/list-your-venue/">Claim or add your venue</a></p>
      </div>
      <ul class="points">
        <li><b>Free</b><span>No fee to be listed or to claim.</span></li>
        <li><b>Your facts</b><span>Owner-supplied details are marked as yours.</span></li>
        <li><b>Real leads</b><span>We count calls, directions and website taps for your venue.</span></li>
      </ul>
    </div>
  </section>
</Base>
