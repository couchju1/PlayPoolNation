---
import Base from '../../layouts/Base.astro';
import PosterCard from '../../components/PosterCard.astro';
import { BRAND, cityPages, metroPages, states, venues } from '../../lib/data.ts';
const cityList = cityPages();
---
<Base
  title={`Find a Pool Table: Every City and State | ${BRAND}`}
  description={`Browse ${venues().length} pool halls and bars with pool tables by city and state, with table counts, league nights and who's open now.`}
  crumbs={[['Home', '/'], ['Places', '']]}
  pageType="places"
>
  <h1>Find a pool table</h1>
  <p class="lede">Pick a city guide, or browse by state. Looking for something specific? <a href="/search/">Search by name, open now or 9-foot tables</a>.</p>
  <section class="section">
    <h2>City guides</h2>
    <ul class="poster-grid">
      {cityList.map((c, i) => <li><PosterCard url={c.url} name={c.name} sub={c.where.split(', ').pop()} count={c.venues.length} eager={i < 4} /></li>)}
      {metroPages().map((m) => <li><PosterCard url={m.url} name={`${m.label} area`} count={m.venues.length} /></li>)}
    </ul>
  </section>
  <section class="section">
    <h2>By state</h2>
    <div class="grid">
      {states().map((s) => (
        <a class="card" href={s.url}><h3>{s.name}</h3><p>{s.venues.length === 1 ? '1 place' : `${s.venues.length} places`}{s.cities.length ? `, ${s.cities.map((c) => c.name).join(', ')}` : ''}</p></a>
      ))}
    </div>
  </section>
</Base>
