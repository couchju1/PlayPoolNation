# Build time (public, baked into pages)
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty

# The PHP endpoints on Hostinger read these from domains/playpoolnation.com/ppn-secrets.php
# (one level above public_html), never from the repository:
#   <?php return ['SUPABASE_URL' => 'https://<ref>.supabase.co', 'SUPABASE_SERVICE_KEY' => '...'];
# npm run db:pull reads them from the environment:
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
